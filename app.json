{
  "expo": {
    "name": "Cofre Klaus",
    "slug": "cofre",
    "scheme": "cofre",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F2F4F8",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cofre.app"
    },
    "android": {
      "package": "com.cofre.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#2A5CE0"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F2F4F8",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0A0D14"
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#2A5CE0"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Cofre usa suas fotos para anexar comprovantes aos lançamentos.",
          "cameraPermission": "O Cofre usa a câmera para fotografar comprovantes."
        }
      ]
    ],
    "extra": {
      "router": {}
    },
    "owner": "cofre-familia",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "platforms": [
      "ios",
      "android"
    ]
  }
}
